---
import units from "../../../../config/units.json";
const lang = Astro.props.lang as "pt" | "en";
const L = lang === "pt"
  ? { unit: "Alojamento", in: "Entrada", out: "Saída", guests: "Hóspedes", calc: "Calcular (simulado)", send: "Enviar pedido (simulado)", name: "Nome", email: "Email", total: "Total", sent: "Maquete: nenhum pedido foi enviado.", note: "Maquete: a cotação usa preços simulados e não há envio real." }
  : { unit: "Accommodation", in: "Check-in", out: "Check-out", guests: "Guests", calc: "Calculate (simulated)", send: "Send request (simulated)", name: "Name", email: "Email", total: "Total", sent: "Mockup: no request was sent.", note: "Mockup: the quote uses simulated prices and nothing is actually sent." };
---
<form id="book" class="book" data-lang={lang} data-labels={JSON.stringify(L)}>
  <p class="note">{L.note}</p>
  <label>{L.unit}
    <select name="unit">{units.units.map((u) => <option value={u.id}>{u.name[lang]}</option>)}</select>
  </label>
  <label>{L.in}<input type="date" name="in" required /></label>
  <label>{L.out}<input type="date" name="out" required /></label>
  <label>{L.guests}<input type="number" name="guests" min="1" max="4" value="2" required /></label>
  <button class="btn" type="submit">{L.calc}</button>
  <div id="result" aria-live="polite"></div>
  <div id="contact" hidden>
    <label>{L.name}<input name="name" /></label>
    <label>{L.email}<input type="email" name="email" /></label>
    <button class="btn outline" type="button" id="send">{L.send}</button>
  </div>
</form>
<style>
  .book { display: grid; gap: 1rem; max-width: 30rem; }
  .book label { display: grid; gap: .25rem; font-size: .9rem; letter-spacing: .05em; }
  .book input, .book select { padding: .8rem; font-family: var(--sans); font: inherit; border: 1px solid #cdbf9d; background: #fff; }
  .note { background: #fff6d8; border-left: 3px solid var(--dourado); padding: .5rem .75rem; font-size: .85rem; margin: 0; }
  #result table { width: 100%; border-collapse: collapse; } #result td { padding: .3rem 0; border-bottom: 1px solid #e6dfce; } #result td:last-child { text-align: right; }
  #contact { display: grid; gap: 1rem; } #contact[hidden] { display: none; }
</style>
<script>
  import { calculateQuote, QuoteError } from "../../../gateway/src/quote";
  import pricing from "../../../../config/pricing.json";
  import units from "../../../../config/units.json";
  const form = document.getElementById("book") as HTMLFormElement;
  const L = JSON.parse(form.dataset.labels!);
  const result = document.getElementById("result")!;
  const contact = document.getElementById("contact")!;
  const fmt = (n: number) => n.toFixed(2).replace(".", ",") + " €";
  const names: Record<string, string> = form.dataset.lang === "pt"
    ? { cleaning: "Limpeza", tourist_tax: "Taxa turística" } : { cleaning: "Cleaning", tourist_tax: "Tourist tax" };
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = new FormData(form);
    try {
      const q = calculateQuote({ unitId: String(f.get("unit")), checkIn: String(f.get("in")), checkOut: String(f.get("out")), guests: Number(f.get("guests")) }, pricing as any, units as any);
      result.innerHTML = "<table>" + q.lines.map((l) => `<tr><td>${names[l.label] ?? l.label}</td><td>${fmt(l.amount)}</td></tr>`).join("") + `<tr><td><strong>${L.total}</strong></td><td><strong>${fmt(q.total)}</strong></td></tr></table>`;
      contact.hidden = false;
    } catch (err) {
      result.textContent = err instanceof QuoteError ? err.message : String(err);
      contact.hidden = true;
    }
  });
  document.getElementById("send")!.addEventListener("click", () => { result.insertAdjacentHTML("beforeend", `<p><em>${L.sent}</em></p>`); });
</script>
