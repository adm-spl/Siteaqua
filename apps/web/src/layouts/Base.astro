---
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/cormorant-garamond/300-italic.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/jost/300.css";
import "@fontsource/jost/400.css";
import "@fontsource/jost/500.css";
import "../styles/global.css";
import { ui, locales, contact, type Lang, type Chrome } from "../lib/site";
import { t as mt } from "../lib/maquete";
interface Props { title: string; description: string; lang: Lang; alternates: Partial<Record<Lang, string>>; chrome: Chrome; overlay?: boolean; }
const { title, description, lang, alternates, chrome, overlay = false } = Astro.props;
const t = ui[lang];
const other = lang === "pt" ? "en" : "pt";
const menuLabel = lang === "pt" ? "Menu" : "Menu";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B231E" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "pt" ? "pt_PT" : "en_GB"} />
    {locales.map((l) => alternates[l] && <link rel="alternate" hreflang={l} href={alternates[l]} />)}
    {alternates.pt && <link rel="alternate" hreflang="x-default" href={alternates.pt} />}
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <div class="maquete">{mt[lang].banner}</div>
    <a class="skip" href="#main">{t.skip}</a>
    <header class:list={["site-header", { overlay }]}>
      <div class="hd">
        <nav class="nav" aria-label="Menu">{chrome.nav.slice(0, 3).map((n) => <a href={n.href}>{n.label}</a>)}</nav>
        <a class="brand" href={`/${lang}/`} aria-label="AquaVillae">Aqua<span>Villae</span></a>
        <div class="hd-r">
          <nav class="nav" aria-label="Menu 2">{chrome.nav.slice(3).map((n) => <a href={n.href}>{n.label}</a>)}</nav>
          {alternates[other] && <a class="lang" href={alternates[other]} hreflang={other} lang={other}>{other.toUpperCase()}</a>}
          <a class="btn" href={chrome.book.href}>{chrome.book.label}</a>
          <details class="menu">
            <summary>{menuLabel}</summary>
            <nav aria-label="Menu mobile">
              {chrome.nav.map((n) => <a href={n.href}>{n.label}</a>)}
              <a href={chrome.book.href}>{chrome.book.label}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="ft">
        <div>
          <a class="brand" href={`/${lang}/`}>Aqua<span>Villae</span></a>
          <p>{t.tagline}</p>
          <p>{contact.address}</p>
        </div>
        <div><h4>{lang === "pt" ? "Explorar" : "Explore"}</h4>
          <ul>{chrome.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
        <div><h4>{lang === "pt" ? "Informação" : "Information"}</h4>
          <ul>{chrome.footer.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></div>
      </div>
      <div class="copy"><span>© {new Date().getFullYear()} AquaVillae. {t.footer.rights}</span><span>{lang === "pt" ? "Registo AL: em processo de licenciamento" : "AL registration: pending"}</span></div>
    </footer>
    <script>
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add("in"));
    </script>
  </body>
</html>
