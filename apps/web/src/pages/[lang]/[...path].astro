---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import BookingMock from "../../components/BookingMock.astro";
import { buildRoutes, unitsFor, chromeFor, alternatesFor, ui, type Route } from "../../lib/site";
import { img, fromPrice, experiences, testimonials, faq, t as mt } from "../../lib/maquete";

export async function getStaticPaths() {
  const routes = await buildRoutes();
  return routes.map((route) => ({ params: { lang: route.lang, path: route.path || undefined }, props: { route, routes } }));
}

const { route, routes } = Astro.props as { route: Route; routes: Route[] };
const { lang, entry, kind } = route;
const t = ui[lang]; const m = mt[lang];
const chrome = chromeFor(routes, lang);
const { Content } = await render(entry);
const unitCards = kind === "home" || kind === "units" ? await unitsFor(lang) : [];
const unitData = kind === "unit" && "unitId" in entry.data ? entry.data : undefined;
const gallery = unitData?.gallery ? [1, 2, 3, 4].map((i) => img(`${unitData.gallery}-${i}`)) : [];
const cover = unitData?.gallery ? img(`${unitData.gallery}-1`) : entry.data.image ? img(entry.data.image) : img("montanhas");
const regionHref = chrome.nav[1].href;
const words = entry.data.title.split(" ");
const last = words.pop();
const price = unitData ? fromPrice(unitData.unitId) : undefined;
---
<Base title={`${entry.data.title} — AquaVillae`} description={entry.data.description} lang={lang}
  alternates={alternatesFor(routes, route.key)} chrome={chrome} overlay>
  {kind === "home" ? (
    <>
      <section class="hero" style={`--bg:url(${img("hero")})`}>
        <div class="inner">
          <span class="eyebrow">{m.eyebrowHero}</span>
          <h1>{words.join(" ")} <em>{last}</em></h1>
          <p class="lead">{entry.data.description}</p>
          <div class="cta"><a class="btn" href={chrome.book.href}>{t.nav.book}</a><a class="btn ghost" href={chrome.nav[0].href}>{t.nav.units}</a></div>
        </div>
        <span class="scroll">{m.scroll}</span>
      </section>
      <section class="wrap">
        <div class="intro reveal">
          <div><span class="eyebrow">{m.welcome}</span><h2>{m.welcomeTitle}</h2></div>
          <div class="body"><Content /></div>
        </div>
        <div class="stats reveal">{m.stats.map(([n, l]) => <div><strong>{n}</strong><span>{l}</span></div>)}</div>
      </section>
    </>
  ) : (
    <section class="page-hero" style={`--bg:url(${cover})`}>
      <div class="inner">
        <span class="eyebrow">{kind === "unit" ? t.nav.units : "AquaVillae"}</span>
        <h1>{entry.data.title}</h1>
      </div>
    </section>
  )}

  {kind !== "home" && (
    <section class="wrap">
      {kind === "unit" ? (
        <div class="layout">
          <div>
            <div class="prose reveal"><p><strong>{entry.data.description}</strong></p><Content /></div>
            {gallery.length > 0 && <div class="gallery reveal">{gallery.map((src) => <img src={src} alt="" loading="lazy" />)}</div>}
          </div>
          <aside class="aside reveal">
            <span class="price">{price ? m.from : m.noPrice}{price && <strong>{price} €</strong>}{price && m.night}</span>
            {unitData && unitData.highlights.length > 0 && <ul>{unitData.highlights.map((h) => <li>{h}</li>)}</ul>}
            <a class="btn" href={chrome.book.href}>{t.nav.book}</a>
          </aside>
        </div>
      ) : (
        <div class="prose reveal">{route.key === "book" ? <BookingMock lang={lang} /> : <Content />}</div>
      )}
    </section>
  )}

  {unitCards.length > 0 && (
    <section class={kind === "home" ? "wrap tight" : "wrap tight"}>
      <div class="head reveal">
        <div>{kind === "home" && <span class="eyebrow">{t.nav.units}</span>}{kind === "home" && <h2>{m.unitsTitle}</h2>}</div>
        {kind === "home" && <a class="link" href={chrome.nav[0].href}>{m.seeAll} →</a>}
      </div>
      <div class="cards">
        {unitCards.map(({ entry: u, href }) => (
          <a class="unit reveal" href={href}>
            <div class="ph">
              <img src={img(`${u.data.gallery}-1`)} alt={u.data.title} loading="lazy" />
              {fromPrice(u.data.unitId) && <span class="tag">{m.from} <strong>{fromPrice(u.data.unitId)} €</strong></span>}
            </div>
            <h3>{u.data.title}</h3>
            <p class="specs">{u.data.highlights.slice(0, 3).join(" · ")}</p>
            <span class="link">{t.seeUnit} →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {kind === "home" && (
    <>
      <section class="region" style="margin-top: clamp(4rem, 9vw, 8rem)">
        <div class="img" style={`--bg:url(${img("termas")})`}></div>
        <div class="txt reveal"><span class="eyebrow">{t.nav.region}</span><h2>{m.regionTitle}</h2><p>{m.regionText}</p><a class="btn" href={regionHref}>{m.regionCta}</a></div>
      </section>
      <section class="wrap">
        <div class="head reveal"><div><span class="eyebrow">{m.expEyebrow}</span><h2>{m.exp}</h2></div></div>
        <div class="exp">{experiences[lang].map((x, i) => (
          <article class="reveal"><div class="ph"><img src={img(x.image)} alt="" loading="lazy" /></div><span class="n">0{i + 1}</span><h3>{x.title}</h3><p>{x.text}</p></article>
        ))}</div>
      </section>
      <section class="quotes"><div class="wrap">
        <div class="head reveal"><div><span class="eyebrow">{m.reviews}</span></div></div>
        <div class="quote-grid">{testimonials[lang].map((x) => <blockquote class="reveal"><p>{x.text}</p><footer>{x.name}</footer></blockquote>)}</div>
      </div></section>
      <section class="wrap"><div class="faq">
        <div class="reveal"><span class="eyebrow">FAQ</span><h2>{m.faq}</h2><p style="margin-top:1.2rem;color:var(--suave)">{m.faqText}</p></div>
        <div class="reveal">{faq[lang].map((x) => <details class="q"><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
      </div></section>
    </>
  )}

  {route.key !== "book" && <section class="cta-band" style={`--bg:url(${img("hero")})`}><div class="wrap tight" style="text-align:center">
    <span class="eyebrow">{m.ctaEyebrow}</span>
    <h2>{m.ctaTitle}</h2>
    <a class="btn" href={chrome.book.href}>{t.nav.book}</a>
  </div></section>}
</Base>
